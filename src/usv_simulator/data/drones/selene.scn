<?xml version="1.0"?>

<scenario xmlns:xacro="http://www.ros.org/wiki/xacro">
    <robot name="selene" fixed="false" self_collisions="false">
    <!--  x 29cm , y 49 cm  from mid-->
        <world_transform xyz="0 0 -0.15" rpy="0 0 3.14159"/>
        <base_link name="Base" type="compound" physics="floating">
            <external_part name="selene_hull_l" type="model" physics="floating" buoyant="true">
                <physical>
                    <mesh filename="../meshes/White.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0 0 0"/>
                </physical>
                <visual>
                    <mesh filename="../meshes/White.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0.0 0 0"/>
                    <look name="White"/>
                </visual>
                <material name="PolyCarbonatePlastic"/>
                <look name="White"/>
                <mass value="25.0"/>
                <cg xyz="0 0 0" rpy="0 0 0"/>
                <compound_transform xyz="0 -0.2875 0.1" rpy="3.14159 0 0"/>
            </external_part>


            <external_part name="selene_hull_r" type="model" physics="floating" buoyant="true">
                <physical>
                    <mesh filename="../meshes/White.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0.0 0 0"/>
                </physical>
                <visual>
                    <mesh filename="../meshes/White.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0.0 0 0"/>
                </visual>
                <material name="PolyCarbonatePlastic"/>
                <look name="White"/>
                <mass value="25.0"/>
                <cg xyz="0 0 0" rpy="0 0 0"/>
                <compound_transform xyz="0 0.2875 0.1" rpy="3.14159 0 0"/>
            </external_part>


            <external_part name="black_rim" type="model" physics="surface">
                <physical>
                    <mesh filename="../meshes/1x1x1mm_cube.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0.0 0 0.1"/>
                </physical>
                <visual>
                    <mesh filename="../meshes/Black_.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0.0 0 0"/>
                </visual>
                <material name="PolyCarbonatePlastic"/>
                <look name="Black"/>
                <mass value="0.1"/>
                <!--<cg xyz="0 0 0" rpy="0 0 0"/>-->
                <compound_transform xyz="0.0 0.0 -0.182" rpy="3.14159 0 0"/>
            </external_part>

            <external_part name="aluminium" type="model" physics="surface">
                <physical>
                    <mesh filename="../meshes/1x1x1mm_cube.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0.0 0 0.5"/>
                </physical>
                <visual>
                    <mesh filename="../meshes/Aluminium.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="-0.005 0 0"/>
                </visual>
                <material name="PolyCarbonatePlastic"/>
                <look name="Gray"/>
                <mass value="0.1"/>
                <!--<cg xyz="0 0 0" rpy="0 0 0"/>-->
                <compound_transform xyz="0.0 0.0 0.096" rpy="3.14159 0 0"/>
            </external_part>
            
            <external_part name="electronics_box" type="model" physics="surface">
                <physical>
                    <mesh filename="../meshes/1x1x1mm_cube.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="-0.06 -0.01 0.31"/>
                </physical>
                <visual>
                    <mesh filename="../meshes/electronics_box.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="-0.06 -0.01 0.31"/>
                </visual>
                <material name="PolyCarbonatePlastic"/>
                <look name="White"/>
                <mass value="0.1"/>
                <!--<cg xyz="0 0 0" rpy="0 0 0"/>-->
                <compound_transform xyz="0.0 0.0 0.0" rpy="3.14159 0 0"/>
            </external_part>
            
            <external_part name="light_column" type="model" physics="surface">
                <physical>
                    <mesh filename="../meshes/1x1x1mm_cube.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0.00 0 0.5"/>
                </physical>
                <visual>
                    <mesh filename="../meshes/light_column.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0.00 0 0.0"/>
                </visual>
                <material name="PolyCarbonatePlastic"/>
                <look name="White"/>
                <mass value="0.1"/>
                <!--<cg xyz="0 0 0" rpy="0 0 0"/>-->
                <compound_transform xyz="0.0 0.0 0.096" rpy="3.14159 0 0"/>
            </external_part>

            <external_part name="wifi_antenna" type="model" physics="surface">
                <physical>
                    <mesh filename="../meshes/1x1x1mm_cube.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0.0 0 0.5"/>
                </physical>
                <visual>
                    <mesh filename="../meshes/wifi_antenna.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0.0 0 0.0"/>
                </visual>
                <material name="PolyCarbonatePlastic"/>
                <look name="Black"/>
                <mass value="0.1"/>
                <!--<cg xyz="0 0 0" rpy="0 0 0"/>-->
                <compound_transform xyz="0.0 0.0 0.096" rpy="3.14159 0 0"/>
            </external_part>

            <external_part name="zed_camera" type="model" physics="surface">
                <physical>
                    <mesh filename="../meshes/1x1x1mm_cube.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0.0 0 0.3"/>
                </physical>
                <visual>
                    <mesh filename="../meshes/camera.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0.00 0 0.0"/>
                </visual>
                <material name="PolyCarbonatePlastic"/>
                <look name="Black"/>
                <mass value="0.1"/>
                <!--<cg xyz="0 0 0" rpy="0 0 0"/>-->
                <compound_transform xyz="0.0 0.0 0.096" rpy="3.14159 0 0"/>
            </external_part>

             <external_part name="camera_column" type="model" physics="surface">
                <physical>
                    <mesh filename="../meshes/1x1x1mm_cube.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0.0 0 0.5"/>
                </physical>
                <visual>
                    <mesh filename="../meshes/camera_column.obj" scale="1"/>
                    <origin rpy="0 0 0" xyz="0.0 0 0.0"/>
                </visual>
                <material name="PolyCarbonatePlastic"/>
                <look name="Black"/>
                <mass value="0.1"/>
                <!--<cg xyz="0 0 0" rpy="0 0 0"/>-->
                <compound_transform xyz="0.0 0.0 0.096" rpy="3.14159 0 0"/>
            </external_part>

           

        </base_link>
        <light name="Omni">
            <specs radius="0.03" illuminance="10000.0"/>
            <color rgb="1.0 0.0 0.0"/>
            <origin xyz="-0.157 0.039 -0.49" rpy="0.0 0.0 0.0"/>
            <link name="Base"/>
        </light>
        <light name="Omni">
            <specs radius="0.03" illuminance="10000.0"/>
            <color rgb="1.0 0.361 0.0"/>
            <origin xyz="-0.157 0.039 -0.45" rpy="0.0 0.0 0.0"/>
            <link name="Base"/>
        </light>
        <light name="Omni">
            <specs radius="0.03" illuminance="10000.0"/>
            <color rgb="0.0 1.0 0.0"/>
            <origin xyz="-0.157 0.039 -0.41" rpy="0.0 0.0 0.0"/>
            <link name="Base"/>
        </light>


    <!--Servo1 & Thruster 1 (left hull front)-->
        <joint name="Joint1" type="revolute">
            <parent name="Base"/>
            <child name="Link1"/>
            <origin xyz="0.49 -0.29 0.09" rpy="0.0 0.0 -3.141592"/>
            <axis xyz="0.0 0.0 1.0"/>
        </joint>
        <link name="Link1" type="model" physics="submerged" buoyant="false" collisions="false">
            <dimensions xyz="0.0405 0.0556 0.020"/>
            <origin xyz="0.0 0 0" rpy="0.0 0.0 0"/>
            <material name="Neutral"/>
            <look name="Black"/>
            <physical>
                <mesh filename="../meshes/1x1x1mm_cube.obj" scale="1"/>
                <origin rpy="0 0 1.5707" xyz="0.0 0 0"/>
            </physical>
            <visual>
                <mesh filename="../meshes/azimuth_detailed.obj" scale="1"/>
                <origin rpy="0 0 1.5707" xyz="0.0 0 0"/>
            </visual>
        </link>

        <actuator name="Servo1" type="servo">
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="40.0" max_velocity="6.0"/>
            <joint name="Joint1"/>
            <initial position="3.1415"/>
        </actuator>

        <actuator name="Thruster1" type="thruster">
            <link name="Link1"/>
            <origin rpy="0.0 0.0 0.0" xyz="0 0 0.1"/>
            <specs max_setpoint="2500.0" inverted_setpoint="false" normalized_setpoint="false"/>
            <propeller diameter="0.18" right="true">
                <mesh filename="../meshes/t200ccw_propeller.obj" scale="1"/>
                <material name="PolyCarbonatePlastic"/>
                <look name="Blue"/>
            </propeller>
            <rotor_dynamics type="zero_order"/>
            <thrust_model type="linear_interpolation">
                <input value="1100 1300 1480 1520 1700 1900"/>
                <output value="-46.0 -20.0 0.0 0.0 20.0 60.0"/>
            </thrust_model>
        </actuator>
    <!-- END Servo1 & Thruster 1 (left hull front)-->
         
   <!--Servo 2 & Thruster 2 (left hull back)-->
     <joint name="Joint2" type="revolute">
            <parent name="Base"/>
            <child name="Link2"/>
            <origin xyz="-0.49 -0.29 0.09" rpy="0.0 0.0 -3.141592"/>
            <axis xyz="0.0 0.0 1.0"/>
        </joint>
        <link name="Link2" type="model" physics="submerged" buoyant="false" collisions="false">
            <dimensions xyz="0.0405 0.0556 0.020"/>
            <origin xyz="0.0 0 0" rpy="0.0 0.0 0"/>
            <material name="Neutral"/>
            <look name="Black"/>
            <physical>
                <mesh filename="../meshes/1x1x1mm_cube.obj" scale="1"/>
                <origin rpy="0 0 1.5707" xyz="0.0 0 0"/>
            </physical>
            <visual>
                <mesh filename="../meshes/azimuth_detailed.obj" scale="1"/>
                <origin rpy="0 0 1.5707" xyz="0.0 0 0"/>
            </visual>
        </link>

        <actuator name="Servo2" type="servo">
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="40.0" max_velocity="6.0"/>
            <joint name="Joint2"/>
            <initial position="3.1415"/>
        </actuator>

        <actuator name="Thruster2" type="thruster">
            <link name="Link2"/>
            <origin rpy="0.0 0.0 0" xyz="0 0 0.1"/>
            <specs max_setpoint="2500.0" inverted_setpoint="false" normalized_setpoint="false"/>
            <propeller diameter="0.18" right="true">
                <mesh filename="../meshes/t200cw_propeller.obj" scale="1"/>
                <material name="PolyCarbonatePlastic"/>
                <look name="Blue"/>
            </propeller>
            <rotor_dynamics type="zero_order"/>
            <thrust_model type="linear_interpolation">
                <input value="1100 1300 1480 1520 1700 1900"/>
                <output value="-46.0 -20.0 0.0 0.0 20.0 60.0"/>
            </thrust_model>
        </actuator>
         <!--END Servo 2 & Thruster 2 (left hull back)-->

          <!--Servo 3 & Thruster 3 (right hull front)-->
        <joint name="Joint3" type="revolute">
            <parent name="Base"/>
            <child name="Link3"/>
            <origin xyz="0.49 0.29 0.09" rpy="0.0 0.0 -3.141592"/>
            <axis xyz="0.0 0.0 1.0"/>
        </joint>
        <link name="Link3" type="model" physics="submerged" buoyant="false" collisions="false">
            <dimensions xyz="0.0405 0.0556 0.020"/>
            <origin xyz="0.0 0 0" rpy="0.0 0.0 0"/>
            <material name="Neutral"/>
            <look name="Black"/>
            <physical>
                <mesh filename="../meshes/1x1x1mm_cube.obj" scale="1"/>
                <origin rpy="0 0 1.5707" xyz="0.0 0 0"/>
            </physical>
            <visual>
                <mesh filename="../meshes/azimuth_detailed.obj" scale="1"/>
                <origin rpy="0 0 1.5707" xyz="0.0 0 0"/>
            </visual>
        </link>

        <actuator name="Servo3" type="servo">
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="40.0" max_velocity="6.0"/>
            <joint name="Joint3"/>
            <initial position="3.1415"/>
        </actuator>

        <actuator name="Thruster3" type="thruster">
            <link name="Link3"/>
            <origin rpy="0.0 0.0 0" xyz="0 0 0.1"/>
            <specs max_setpoint="2500.0" inverted_setpoint="false" normalized_setpoint="false"/>
            <propeller diameter="0.18" right="true">
                <mesh filename="../meshes/t200cw_propeller.obj" scale="1"/>
                <material name="PolyCarbonatePlastic"/>
                <look name="Blue"/>
            </propeller>
            <rotor_dynamics type="zero_order"/>
            <thrust_model type="linear_interpolation">
                <input value="1100 1300 1480 1520 1700 1900"/>
                <output value="-46.0 -20.0 0.0 0.0 20.0 60.0"/>
            </thrust_model>
        </actuator>
        <!--END Servo 3 & Thruster 3 (left hull front)-->

    <!--Servo 4 & Thruster 4 (right hull back)-->
        <joint name="Joint4" type="revolute">
            <parent name="Base"/>
            <child name="Link4"/>
            <origin xyz="-0.49 0.29 0.09" rpy="0.0 0.0 -3.141592"/>
            <axis xyz="0.0 0.0 1.0"/>
        </joint>
        <link name="Link4" type="model" physics="submerged" buoyant="false" collisions="false">
            <dimensions xyz="0.0405 0.0556 0.020"/>
            <origin xyz="0.0 0 0" rpy="0.0 0.0 0"/>
            <material name="Neutral"/>
            <look name="Black"/>
            <physical>
                <mesh filename="../meshes/1x1x1mm_cube.obj" scale="1"/>
                <origin rpy="0 0 1.5707" xyz="0.0 0 0"/>
            </physical>
            <visual>
                <mesh filename="../meshes/azimuth_detailed.obj" scale="1"/>
                <origin rpy="0 0 1.5707" xyz="0.0 0 0"/>
            </visual>
        </link>

        <actuator name="Servo4" type="servo">
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="40.0" max_velocity="6.0"/>
            <joint name="Joint4"/>
            <initial position="3.1415"/>
        </actuator>

        <actuator name="Thruster4" type="thruster">
            <link name="Link4"/>
            <origin rpy="0.0 0.0 0" xyz="0 0 0.1"/>
            <specs max_setpoint="2500.0" inverted_setpoint="false" normalized_setpoint="false"/>
            <propeller diameter="0.18" right="true">
                <mesh filename="../meshes/t200ccw_propeller.obj" scale="1"/>
                <material name="PolyCarbonatePlastic"/>
                <look name="Blue"/>
            </propeller>
            <rotor_dynamics type="zero_order"/>
            <thrust_model type="linear_interpolation">
                <input value="1100 1300 1480 1520 1700 1900"/>
                <output value="-46.0 -20.0 0.0 0.0 20.0 60.0"/>
            </thrust_model>
        </actuator> 

    <!--Sensors-->
        <sensor name="Dcam" rate="60.0" type="depthcamera">
            <specs resolution_x="1280" resolution_y="720" horizontal_fov="72.0" vertical_fov="44.0" depth_min="0.2" depth_max="20.0"/>
            <noise depth="0.02"/>
            <origin xyz="0.355 -0.06 -0.35" rpy="-1.57079632679 -3.14159265359-1.57079632679"/>
            <link name="Base"/>
            <ros_publisher topic="selene/sensors/depth_camera"/>
        </sensor>

        <sensor name="Ccam" rate="60.0" type="camera">
            <specs resolution_x="1280" resolution_y="720" horizontal_fov="72.0" vertical_fov="44.0"/>
            <origin xyz="0.355 -0.06 -0.35" rpy="-1.57079632679 -3.14159265359-1.57079632679"/>
            <link name="Base"/>
            <ros_publisher topic="selene/sensors/color_camera"/>
        </sensor>

        <sensor name="imu" rate="100.0" type="imu">
            <range angular_velocity="10.0 10.0 10.0" linear_acceleration="10.0"/>
            <noise angle="0.000000001 0.000001 0.000005" angular_velocity="0.00000005" yaw_drift="0.0000001" linear_acceleration="0.0001"/>
            <history samples="1"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <link name="Base"/>
            <ros_publisher topic="/sensors/imu"/>
        </sensor>

        <sensor name="gps" rate="10" type="gps">
            <noise ned_position="0.05"/>
            <history samples="10"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <link name="Base"/>
            <ros_publisher topic="/sensors/gps"/>
        </sensor>

        <sensor name="Odometry" rate="100.0" type="odometry">
            <noise position="0.000001" velocity="0.0000001" angle="0.0000001" angular_velocity="0.000005"/> 
            <history samples="10"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <link name="Base"/>
            <ros_publisher topic="/sensors/odometry"/>
        </sensor>
    <!--ROS2 Integration-->
    
    <!--Actuator topics-->
        <ros_subscriber thrusters="/thruster_setpoints" servos="/servo_setpoints"/>
        <ros_publisher thrusters="/thruster_states" servos="/servo_states"/> <!--NB: Doesn't publish any data on real hardware-->

        

  
    
    <!--Sensor topics-->
    
    
    

    </robot>
</scenario>

