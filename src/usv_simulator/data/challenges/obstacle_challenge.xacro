<?xml version="1.0"?>
<scenario xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="buoy" params="name color x y">
    <static name="${name}" type="model">
        <physical>
            <mesh filename="../meshes/Buoy.obj" scale="1.0" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <visual>
            <mesh filename="../meshes/Buoy.obj" scale="1.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <material name="Rock"/>
        <look name="${color}"/>
        <world_transform xyz="${x} ${y} 0.0" rpy="0.0 0.0 0.0"/>
    </static>
</xacro:macro>

<!-- Obstacle challange-->
<xacro:buoy name="R1_ch1" color="Red" x="10.0" y="-1.5"/>
<xacro:buoy name="R2_ch1" color="Red" x="20.0" y="-1.5"/>
<xacro:buoy name="R3_ch1" color="Red" x="30.0" y="-1.5"/>
<xacro:buoy name="R4_ch1" color="Red" x="40.0" y="-1.5"/>
<xacro:buoy name="R5_ch1" color="Red" x="50.0" y="-1.5"/>
<xacro:buoy name="R6_ch1" color="Red" x="60.0" y="-1.5"/>
<xacro:buoy name="R7_ch1" color="Red" x="70.0" y="-1.5"/>
<xacro:buoy name="R8_ch1" color="Red" x="80.0" y="-1.5"/>
<xacro:buoy name="R9_ch1" color="Red" x="90.0" y="-1.5"/>
<xacro:buoy name="R10_ch1" color="Red" x="100.0" y="-1.5"/>

<xacro:buoy name="G1_ch1" color="Green" x="10.0" y="1.5"/>
<xacro:buoy name="G2_ch1" color="Green" x="20.0" y="1.5"/>
<xacro:buoy name="G3_ch1" color="Green" x="30.0" y="1.5"/>
<xacro:buoy name="G4_ch1" color="Green" x="40.0" y="1.5"/>
<xacro:buoy name="G5_ch1" color="Green" x="50.0" y="1.5"/>
<xacro:buoy name="G6_ch1" color="Green" x="60.0" y="1.5"/>
<xacro:buoy name="G7_ch1" color="Green" x="70.0" y="1.5"/>
<xacro:buoy name="G8_ch1" color="Green" x="80.0" y="1.5"/>
<xacro:buoy name="G9_ch1" color="Green" x="90.0" y="1.5"/>
<xacro:buoy name="G10_ch1" color="Green" x="100.0" y="1.5"/>


<!-- Obstacles -->
<xacro:buoy name="Obstacle 1" color="Yellow" x="35.0" y="0.2"/>
<xacro:buoy name="Obstacle 1" color="Yellow" x="55.0" y="-0.2"/>






</scenario>



