<?xml version="1.0"?>
<scenario xmlns:xacro="http://www.ros.org/wiki/xacro">

<robot name="PassingBoat" fixed="true" self_collisions="false">
    <!--  x 29cm , y 49 cm  from mid-->
        <world_transform xyz="-10 -10 0" rpy="0 0 0"/>
        <base_link name="Base" type="compound" physics="floating">
            <external_part name="boat_model" type="model" physics="floating" buoyant="true">
                <physical>
                    <mesh filename="../meshes/Buoy.obj" scale="4"/>
                    <origin rpy="0 0 0" xyz="0 0 0"/>
                </physical>
                <visual>
                    <mesh filename="../meshes/Buoy.obj" scale="4"/>
                    <origin rpy="0 0 0" xyz="0.0 0 0"/>
                    <look name="Yellow"/>
                </visual>

                <material name="Neutral"/>
                <look name="Yellow"/>
                <mass value="50"/>
                <cg xyz="0 0 -1" rpy="0 0 0"/>
                <compound_transform xyz="0 0 0" rpy="3.14 0 0"/>
            </external_part>
        </base_link>



        <joint name="Joint1" type="prismatic">
            <parent name="Base"/>
            <child name="Link1"/>
            <origin xyz="0.0 -10.0 0.00" rpy="0.0 0.0 0"/>
            <axis xyz="0.0 -1.0 0.0"/> <!-- Direction -1 negative y axis/west-->
        </joint>
        <link name="Link1" type="model" physics="submerged" buoyant="false" collisions="false">
            <origin xyz="0.0 0 0" rpy="0.0 0.0 0"/>
            <material name="Neutral"/>
            <look name="Black"/>
            <physical>
                <mesh filename="../meshes/SeaAngler.obj" scale="4"/>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </physical>
            <visual>
                <mesh filename="../meshes/SeaAngler.obj" scale="4"/>
                <origin rpy="0 0 0" xyz="0.0 0 0"/>
                <look name="Yellow"/>
            </visual>
        </link>

        <actuator name="Piston" type="servo">
            <controller position_gain="10.0" velocity_gain="10.0" max_torque="5400.0" max_velocity="10.0"/>
            <joint name="Joint1"/>
            <initial position="0.0"/>
        </actuator>

        <ros_subscriber servos="/linear_actuator"/>
        <ros_publisher servos="/linear_actuator_states"/>


    <!--ROS2 Integration
        <sensor name="Odometry" rate="100.0" type="odometry">
            <noise position="0.000001" velocity="0.0000001" angle="0.0000001" angular_velocity="0.000005"/> 
            <history samples="10"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <link name="Base"/>
            <ros_publisher topic="/boat/odometry"/>
        </sensor>
        -->
    
   

    </robot>


</scenario>