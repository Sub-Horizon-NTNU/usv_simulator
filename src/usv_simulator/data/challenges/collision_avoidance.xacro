<?xml version="1.0"?>
<scenario xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="incoming_boat" params="name x y dir_vec_x dir_vec_y dir_vec_z heading">

<robot name="${name}" fixed="true" self_collisions="false">
    <!--  x 29cm , y 49 cm  from mid-->
        <world_transform xyz="${x} ${y} 0" rpy="0 0 0"/>
        <base_link name="Base" type="compound" physics="floating">
            <external_part name="boat_model" type="model" physics="floating" buoyant="true">
                <physical>
                    <mesh filename="../meshes/Buoy.obj" scale="0.1"/>
                    <origin rpy="0 0 0" xyz="0 0 0"/>
                </physical>
                <visual>
                    <mesh filename="../meshes/Buoy.obj" scale="0.1"/>
                    <origin rpy="0 0 0" xyz="0.0 0 0"/>
                    <look name="Yellow"/>
                </visual>

                <material name="Neutral"/>
                <look name="Yellow"/>
                <mass value="50"/>
                <cg xyz="0 0 -1" rpy="0 0 0"/>
                <compound_transform xyz="0 0 0" rpy="0 0 0"/>
            </external_part>
        </base_link>

<!-- Linear actuator-->

        <joint name="piston" type="prismatic">
            <parent name="Base"/>
            <child name="Link1"/>
            <origin xyz="0.0 0.0 0.00" rpy="0.0 0.0 0"/>
            <axis xyz="${dir_vec_x} ${dir_vec_y} ${dir_vec_z}"/> <!-- Direction -1 negative y axis/west-->
        </joint>
        <link name="Link1" type="model" physics="submerged" buoyant="false" collisions="false">
            <origin xyz="0.0 0 0" rpy="0.0 0.0 0"/>
            <material name="Neutral"/>
            <look name="Black"/>
            <physical>
                <mesh filename="../meshes/Buoy.obj" scale="0.1"/>
                <origin rpy="3.14159 0 ${heading}" xyz="0 0 -0.1"/>
            </physical>
            <visual>
                <mesh filename="../meshes/Buoy.obj" scale="0.1"/>
                <origin rpy="3.14159 0 ${heading}" xyz="0.0 0 -0.1"/>
                <look name="Yellow"/>
            </visual>
        </link>

        <actuator name="piston" type="servo">
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="5400000.0" max_velocity="10.0"/>
            <joint name="piston"/>
            <initial position="0.0"/>
        </actuator>

<!-- Rotational joint-->
        <joint name="rotation" type="revolute">
            <parent name="Link1"/>
            <child name="Link2"/>
            <origin xyz="0.0 0.0 0.00" rpy="0.0 0.0 0"/>
            <axis xyz="0 0 -1"/> <!-- Direction -1 negative y axis/west-->
        </joint>
        <link name="Link2" type="model" physics="submerged" buoyant="false" collisions="false">
            <origin xyz="0.0 0 0" rpy="0.0 0.0 0"/>
            <material name="Neutral"/>
            <look name="Black"/>
            <physical>
                <mesh filename="../meshes/SeaAngler.obj" scale="4"/>
                <origin rpy="3.14159 0 0" xyz="0 0 0"/>
            </physical>
            <visual>
                <mesh filename="../meshes/SeaAngler.obj" scale="4"/>
                <origin rpy="3.14159 0 0" xyz="0.0 0 0"/>
                <look name="Yellow"/>
            </visual>
        </link>

        <actuator name="rotation" type="servo">
            <controller position_gain="1.00" velocity_gain="1.0" max_torque="540000.0" max_velocity="10.0"/>
            <joint name="rotation"/>
            <initial position="0.0"/>
        </actuator>

        <ros_subscriber servos="/${name}/position"/>
        <ros_publisher servos="/${name}/position_states"/>

    </robot>
</xacro:macro>


<xacro:incoming_boat name="boat1" x="-10" y="-10" dir_vec_x="0" dir_vec_y="-1" dir_vec_z="0" heading="-1.57"/>

</scenario>