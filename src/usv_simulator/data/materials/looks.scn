<?xml version="1.0"?>
<scenario xmlns:xacro="http://www.ros.org/wiki/xacro">    
    <looks>
        <!--NB! Textures needs a UV map in order to be rendered.-->
        <look name="Yellow" rgb="1.0 0.9 0.0" roughness="0.3"/>
        <look name="Gray" gray="0.1" roughness="0.4" metalness="0.5"/>
        <look name="Green" rgb="0.0 0.8 0.0" roughness="0.9"/>
        <look name="Red" rgb="0.8 0.0 0.0" roughness="0.9" metalness="0.9"/>
        <look name="Blue" rgb="0.0 0.0 1.0" roughness="0.9" metalness="0.9"/>

        <look name="LightGreen" rgb="0.0 0.8 0.0" roughness="0.9"/>
        <look name="Invisible" rgb="1 1 1" roughness="0.2" alpha="0.0"/>
        <look name="White" rgb="1.0 1.0 1.0" roughness="0.2"/>
        <look name="Brown" rgb="0.5 0.3 0.0" roughness="0.9" metalness="0.0" reflectivity="0.1"/>
        <look name="Black" rgb="0.0 0.0 0.0" roughness="1.0"/>
        <look name="CarbonFiber" gray="1.0" reflectivity="0.7" roughness="0.2" texture="../textures/CarbonFiber.png"/>
        <look name="Concrete" gray="1.0" reflectivity="0.5" roughness="0.2" texture="../textures/concrete.png"/>
        <look name="Wood" gray="1.0" reflectivity="0.5" roughness="0.2" texture="../textures/wood.png"/>

        <look name="output_map_texture" gray="0.5" reflectivity="0.7" roughness="0.2" texture="../textures/output_map_texture.png"/>

    </looks>
</scenario>
 