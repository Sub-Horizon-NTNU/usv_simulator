<?xml version="1.0"?>
<scenario>
  <animated name="BuoyGreenStarboard" type="model"collisions ="true">
    <physical>
      <mesh filename="../meshes/BuoyRow.obj" scale="1.0" convex="true"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </physical>
    <visual>
      <mesh filename="../meshes/BuoyRow.obj" scale="1.0"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </visual>
    <material name="Rock"/>
    <look name="Green"/>
    <world_transform xyz="1.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <trajectory type="spline" playback="repeat">
      <keypoint time="0.0" xyz="10.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <keypoint time="2.0" xyz="10.5 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <keypoint time="4.0" xyz="10.0 0.0 0.0" rpy="0.0 0.0 0.0"/> 
  </trajectory>
  </animated>

  <animated name="BuoyRedPort" type="model" collisions="true">
    <physical>
      <mesh filename="../meshes/BuoyRow.obj" scale="1.0" convex="true"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </physical>
    <visual>
      <mesh filename="../meshes/BuoyRow.obj" scale="1.0"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </visual>
    <material name="Rock"/>
    <look name="Red"/>
    <world_transform xyz="1.0 -3.0 0.5" rpy="0.0 0.0 0.0"/>
   <trajectory type="spline" playback="repeat">
      <keypoint time="0.0" xyz="10.0 -3.0 0.0" rpy="0.0 0.0 0.0"/>
      <keypoint time="2.0" xyz="10.5 -3.0 0.0" rpy="0.0 0.0 0.0"/>
      <keypoint time="4.0" xyz="10.0 -3.0 0.0" rpy="0.0 0.0 0.0"/>
  </trajectory>
  </animated>
</scenario>